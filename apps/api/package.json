{
  "name": "@admission-engine/api",
  "version": "1.0.0",
  "private": true,
  "description": "High-Throughput Question Engine and Delivery REST API",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "pnpm --filter @admission-engine/types build && pnpm --filter @admission-engine/database build",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@admission-engine/database": "workspace:*",
    "@admission-engine/types": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
